+++ b/swift/Steno/Tests/StenoTests/MenuViewModelTests.swift
@@ -1,3 +1,21 @@
+func test_make_soonestRowShowsCountdown_restShowCount() {
+    let soonest = meeting(
+        title: "Standup", attendeeCount: 4,
+        start: now.addingTimeInterval(15 * 60))
+    let second = meeting(
+        title: "1:1", attendeeCount: 2,
+        start: now.addingTimeInterval(90 * 60))
+    let third = meeting(
+        title: "All hands", attendeeCount: 40,
+        start: now.addingTimeInterval(180 * 60))
+
+    let vm = MenuViewModel.make(
+        now: now, upcoming: [soonest, second, third])
+
+    XCTAssertEqual(vm.upcoming[0].trailingText, "in 15m")
+    XCTAssertEqual(vm.upcoming[1].trailingText, "2 people")
+    XCTAssertEqual(vm.upcoming[2].trailingText, "40 people")
+}
