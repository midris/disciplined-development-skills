+++ b/swift/Steno/Sources/Steno/Calendar/CalendarView.swift
@@ -142,3 +142,9 @@
+public func upcoming(now: Date) -> [CalendarMeeting] {
+    meetings.values
+        .filter { $0.end >= now }
+        .sorted { $0.start == $1.start ? $0.id < $1.id : $0.start < $1.start }
+}
diff --git a/swift/Steno/Sources/Steno/Health/MenuViewModel.swift b/swift/Steno/Sources/Steno/Health/MenuViewModel.swift
index 7777777..8888888 100644
--- a/swift/Steno/Sources/Steno/Health/MenuViewModel.swift
+++ b/swift/Steno/Sources/Steno/Health/MenuViewModel.swift
@@ -100,3 +100,24 @@
+public static func make(
+    now: Date,
+    upcoming: [UpcomingMeetingView]
+) -> MenuViewModel {
+    let upcomingRows = upcoming.enumerated().map { index, meetingView in
+        let trailingText: String
+        if index == 0 {
+            let minutes = max(0, Int(meetingView.start.timeIntervalSince(now) / 60))
+            trailingText = "in \(minutes)m"
+        } else {
+            trailingText = "\(meetingView.attendeeCount) people"
+        }
+        return UpcomingRow(
+            timeText: Self.timeText(for: meetingView.start),
+            title: meetingView.title,
+            trailingText: trailingText)
+    }
+    return MenuViewModel(upcoming: upcomingRows)
+}
diff --git a/swift/Steno/Tests/StenoTests/MenuViewModelTests.swift b/swift/Steno/Tests/StenoTests/MenuViewModelTests.swift
