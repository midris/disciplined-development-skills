diff --git a/swift/Steno/Sources/Steno/Calendar/CalendarEngine.swift b/swift/Steno/Sources/Steno/Calendar/CalendarEngine.swift
index 3333333..4444444 100644
--- a/swift/Steno/Sources/Steno/Calendar/CalendarEngine.swift
+++ b/swift/Steno/Sources/Steno/Calendar/CalendarEngine.swift
@@ -117,3 +117,30 @@
+public struct UpcomingMeetingView: Equatable, Sendable {
+    public let title: String
+    public let attendeeCount: Int
+    public let start: Date
+    public let end: Date
+}
+
+public protocol CalendarUpcomingReading: Sendable {
+    /// The next `limit` upcoming meetings, sorted by start then id.
+    func upcomingMeetings(now: Date, limit: Int) async -> [UpcomingMeetingView]
+}
+
+extension CalendarEngine: CalendarUpcomingReading {
+    public func upcomingMeetings(now: Date, limit: Int) async -> [UpcomingMeetingView] {
+        guard config.enabled else { return [] }
+        return view.upcoming(now: now).prefix(Swift.max(0, limit)).map {
+            UpcomingMeetingView(
+                title: $0.title,
+                attendeeCount: $0.attendees.count,
+                start: $0.start,
+                end: $0.end)
+        }
+    }
+}
diff --git a/swift/Steno/Sources/Steno/Calendar/CalendarView.swift b/swift/Steno/Sources/Steno/Calendar/CalendarView.swift
