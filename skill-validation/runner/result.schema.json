{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "status", "started_at", "finished_at", "duration_seconds", "test", "execution", "inputs", "artifacts", "infrastructure_error"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string"},
    "status": {"enum": ["COMPLETED", "INFRA_ERROR"]},
    "started_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "finished_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "duration_seconds": {"type": "number", "minimum": 0},
    "test": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "skill", "dependencies", "scenario"],
      "properties": {
        "id": {"type": "string"}, "skill": {"type": "string"},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "scenario": {"type": "string"}
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "model", "effort", "executable", "timeout_seconds", "invocation_started", "timed_out", "exit_code"],
      "properties": {
        "provider": {"enum": ["codex", "claude"]}, "model": {"type": "string"}, "effort": {"type": "string"},
        "executable": {"enum": ["codex", "claude"]}, "timeout_seconds": {"const": 900},
        "invocation_started": {"type": "boolean"}, "timed_out": {"type": "boolean"},
        "exit_code": {"type": ["integer", "null"]}
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "artifacts": {
      "type": "object", "additionalProperties": false,
      "required": ["config", "subject_input", "stdout", "stderr", "final", "workspace"],
      "properties": {
        "config": {"allOf": [{"$ref": "#/$defs/file_artifact"}, {"properties": {"path": {"const": "config.json"}}}]},
        "subject_input": {"allOf": [{"$ref": "#/$defs/file_artifact"}, {"properties": {"path": {"const": "subject-input.txt"}}}]},
        "stdout": {"allOf": [{"$ref": "#/$defs/file_artifact"}, {"properties": {"path": {"const": "stdout.txt"}}}]},
        "stderr": {"allOf": [{"$ref": "#/$defs/file_artifact"}, {"properties": {"path": {"const": "stderr.txt"}}}]},
        "final": {"allOf": [{"$ref": "#/$defs/file_artifact"}, {"properties": {"path": {"const": "final.txt"}}}]},
        "workspace": {"$ref": "#/$defs/workspace_artifact"}
      }
    },
    "infrastructure_error": {
      "anyOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {
          "code": {"enum": ["PREPARATION_FAILED", "PROVIDER_LAUNCH_FAILED", "PROVIDER_TIMEOUT", "PROVIDER_EXIT_NONZERO", "PROVIDER_OUTPUT_INVALID", "FINAL_OUTPUT_MISSING", "ARTIFACT_WRITE_FAILED"]},
          "message": {"type": "string"}
        }}
      ]
    }
  },
  "allOf": [{
    "if": {"properties": {"status": {"const": "COMPLETED"}}},
    "then": {"properties": {"infrastructure_error": {"type": "null"}}},
    "else": {"properties": {"infrastructure_error": {"type": "object"}}}
  }],
  "$defs": {
    "file_artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "exists", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string"}, "exists": {"type": "boolean"},
        "bytes": {"type": ["integer", "null"], "minimum": 0},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      },
      "allOf": [{
        "if": {"properties": {"exists": {"const": true}}},
        "then": {"properties": {"bytes": {"type": "integer", "minimum": 0}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
        "else": {"properties": {"bytes": {"type": "null"}, "sha256": {"type": "null"}}}
      }]
    },
    "workspace_artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "exists"],
      "properties": {"path": {"const": "workspace"}, "exists": {"type": "boolean"}}
    }
  }
}
