{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "status", "started_at", "finished_at", "duration_seconds", "test", "execution", "artifacts", "infrastructure_error"],
  "properties": {
    "schema_version": {"const": "0.2"},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["COMPLETED", "INFRA_ERROR"]},
    "started_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "finished_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "duration_seconds": {"type": "number", "minimum": 0},
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "effort", "executable", "timeout_seconds", "invocation_started", "timed_out", "exit_code"],
      "properties": {
        "provider": {"enum": ["codex", "claude"]},
        "model": {"type": "string", "minLength": 1},
        "effort": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "executable": {"enum": ["codex", "claude"]},
        "timeout_seconds": {"const": 900},
        "invocation_started": {"type": "boolean"},
        "timed_out": {"type": "boolean"},
        "exit_code": {"type": ["integer", "null"]}
      },
      "oneOf": [
        {"properties": {"provider": {"const": "codex"}, "executable": {"const": "codex"}}},
        {"properties": {"provider": {"const": "claude"}, "executable": {"const": "claude"}}}
      ]
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config", "prompt_template", "prompt", "stdout", "stderr", "final", "fixture", "evidence"],
      "properties": {
        "config": {"allOf": [{"$ref": "#/$defs/file_artifact"}, {"properties": {"path": {"const": "config.json"}}}]},
        "prompt_template": {"allOf": [{"$ref": "#/$defs/file_artifact"}, {"properties": {"path": {"const": "prompt-template.txt"}}}]},
        "prompt": {"allOf": [{"$ref": "#/$defs/file_artifact"}, {"properties": {"path": {"const": "prompt.txt"}}}]},
        "stdout": {"allOf": [{"$ref": "#/$defs/file_artifact"}, {"properties": {"path": {"const": "stdout.txt"}}}]},
        "stderr": {"allOf": [{"$ref": "#/$defs/file_artifact"}, {"properties": {"path": {"const": "stderr.txt"}}}]},
        "final": {"allOf": [{"$ref": "#/$defs/file_artifact"}, {"properties": {"path": {"const": "final.txt"}}}]},
        "fixture": {"allOf": [{"$ref": "#/$defs/directory_artifact"}, {"properties": {"path": {"const": "workspace/fixture"}}}]},
        "evidence": {"allOf": [{"$ref": "#/$defs/directory_artifact"}, {"properties": {"path": {"const": "workspace/evidence"}}}]}
      }
    },
    "infrastructure_error": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/infrastructure_error"}
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "status": {"const": "COMPLETED"},
        "execution": {"properties": {"invocation_started": {"const": true}, "timed_out": {"const": false}, "exit_code": {"const": 0}}},
        "infrastructure_error": {"type": "null"}
      }
    },
    {
      "properties": {
        "status": {"const": "INFRA_ERROR"},
        "execution": {"properties": {"invocation_started": {"const": false}, "timed_out": {"const": false}, "exit_code": {"type": "null"}}},
        "infrastructure_error": {"type": "object", "properties": {"code": {"const": "PREPARATION_FAILED"}}}
      }
    },
    {
      "properties": {
        "status": {"const": "INFRA_ERROR"},
        "execution": {"properties": {"invocation_started": {"const": false}, "timed_out": {"const": false}, "exit_code": {"type": "null"}}},
        "infrastructure_error": {"type": "object", "properties": {"code": {"const": "PROVIDER_LAUNCH_FAILED"}}}
      }
    },
    {
      "properties": {
        "status": {"const": "INFRA_ERROR"},
        "execution": {"properties": {"invocation_started": {"const": true}, "timed_out": {"const": true}, "exit_code": {"type": "integer"}}},
        "infrastructure_error": {"type": "object", "properties": {"code": {"const": "PROVIDER_TIMEOUT"}}}
      }
    },
    {
      "properties": {
        "status": {"const": "INFRA_ERROR"},
        "execution": {"properties": {"invocation_started": {"const": true}, "timed_out": {"const": false}, "exit_code": {"type": "integer", "not": {"const": 0}}}},
        "infrastructure_error": {"type": "object", "properties": {"code": {"const": "PROVIDER_EXIT_NONZERO"}}}
      }
    },
    {
      "properties": {
        "status": {"const": "INFRA_ERROR"},
        "execution": {"properties": {"invocation_started": {"const": true}, "timed_out": {"const": false}, "exit_code": {"const": 0}}},
        "infrastructure_error": {"type": "object", "properties": {"code": {"const": "ARTIFACT_WRITE_FAILED"}}}
      }
    }
  ],
  "$defs": {
    "file_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "exists", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string"},
        "exists": {"type": "boolean"},
        "bytes": {"type": ["integer", "null"]},
        "sha256": {"type": ["string", "null"]}
      },
      "oneOf": [
        {"properties": {"exists": {"const": true}, "bytes": {"type": "integer", "minimum": 0}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
        {"properties": {"exists": {"const": false}, "bytes": {"type": "null"}, "sha256": {"type": "null"}}}
      ]
    },
    "directory_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "exists", "empty", "entries"],
      "properties": {
        "path": {"type": "string"},
        "exists": {"type": "boolean"},
        "empty": {"type": ["boolean", "null"]},
        "entries": {"type": "array", "items": {"$ref": "#/$defs/directory_entry"}}
      },
      "oneOf": [
        {"properties": {"exists": {"const": false}, "empty": {"type": "null"}, "entries": {"maxItems": 0}}},
        {"properties": {"exists": {"const": true}, "empty": {"const": true}, "entries": {"maxItems": 0}}},
        {"properties": {"exists": {"const": true}, "empty": {"const": false}, "entries": {"minItems": 1}}}
      ]
    },
    "directory_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "type", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "type": {"enum": ["file", "directory", "symlink", "other"]},
        "bytes": {"type": ["integer", "null"]},
        "sha256": {"type": ["string", "null"]}
      },
      "oneOf": [
        {"properties": {"type": {"const": "file"}, "bytes": {"type": "integer", "minimum": 0}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
        {"properties": {"type": {"enum": ["directory", "symlink", "other"]}, "bytes": {"type": "null"}, "sha256": {"type": "null"}}}
      ]
    },
    "infrastructure_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"enum": ["PREPARATION_FAILED", "PROVIDER_LAUNCH_FAILED", "PROVIDER_TIMEOUT", "PROVIDER_EXIT_NONZERO", "ARTIFACT_WRITE_FAILED"]},
        "message": {"type": "string"}
      }
    }
  }
}
